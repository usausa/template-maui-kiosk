<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Main"
             x:Class="Template.MobileApp.Modules.Main.MenuView"
             x:DataType="{x:Type module:MenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:MenuViewModel}"
             shell:ShellProperty.Title="Menu"
             shell:ShellProperty.FunctionVisible="False">

    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="MessageLabel"
                   TargetType="Label">
                <Setter Property="Padding" Value="12" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource BlueDarken3}" />
                <Setter Property="BackgroundColor" Value="{StaticResource BlueLighten5}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Style="{StaticResource MessageLabel}"
               IsVisible="{Binding Kiosk.Message, Converter={StaticResource NotEmptyConverter}}"
               Text="{Binding Kiosk.Message}" />

        <Grid Grid.Row="1"
              Style="{StaticResource MenuGrid}"
              RowDefinitions="*,*,*,*,*,*,*,*,*">

            <Button Grid.Row="0"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding ForwardCommand}"
                    CommandParameter="{markup:ViewId KioskStatus}"
                    Text="Status" />
            <Button Grid.Row="1"
                    Style="{StaticResource MenuButton}"
                    Command="{Binding AdminCommand}"
                    Text="Admin" />

        </Grid>
    </Grid>

</ContentView>
