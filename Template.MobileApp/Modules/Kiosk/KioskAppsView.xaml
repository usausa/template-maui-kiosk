<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Kiosk"
             x:Class="Template.MobileApp.Modules.Kiosk.KioskAppsView"
             x:DataType="{x:Type module:KioskAppsViewModel}"
             s:BindingContextResolver.Type="{x:Type module:KioskAppsViewModel}"
             shell:ShellProperty.Title="Apps"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Layout -->

            <Style x:Key="AppsStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="AppsNoteLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ValueLabel}">
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="AppsButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="HeightRequest" Value="56" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource AppsStack}"
                             BindableLayout.ItemsSource="{Binding Apps}">
            <BindableLayout.EmptyView>
                <Label Style="{StaticResource AppsNoteLabel}"
                       Text="No apps" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:KioskApp}">
                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                    <Button Style="{StaticResource AppsButton}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type module:KioskAppsViewModel}}, Path=LaunchCommand, x:DataType={x:Type module:KioskAppsViewModel}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsInstalled}"
                            Text="{Binding Name}" />
                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
