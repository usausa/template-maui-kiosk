<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Kiosk"
             x:Class="Template.MobileApp.Modules.Kiosk.KioskPolicyView"
             x:DataType="{x:Type module:KioskPolicyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:KioskPolicyViewModel}"
             shell:ShellProperty.Title="Device policy"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <ContentView.Resources>
        <ResourceDictionary>

            <!-- Converter -->

            <s:BoolToTextConverter x:Key="AppliedConverter"
                                   TrueValue="Applied"
                                   FalseValue="Not applied" />

            <!-- Layout -->

            <Style x:Key="PolicyStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="PolicyRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <Style x:Key="PolicyNameLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource NameLabel}">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="PolicyValueLabel"
                   TargetType="Label"
                   BasedOn="{StaticResource ValueLabel}">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="PolicyButtonGrid"
                   TargetType="Grid">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Content -->
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PolicyStack}">

            <Grid Style="{StaticResource PolicyRowGrid}"
                  ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource PolicyNameLabel}"
                       Text="State" />
                <Label Grid.Column="1"
                       Style="{StaticResource PolicyValueLabel}"
                       Text="{Binding Kiosk.IsPolicyApplied, Converter={StaticResource AppliedConverter}}" />
            </Grid>
            <Grid Style="{StaticResource PolicyButtonGrid}"
                  ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyPolicyCommand}"
                        Text="Apply" />
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearPolicyCommand}"
                        Text="Clear" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
